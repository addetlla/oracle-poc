<!--
  Employee Directory Page - BurgerQuick CRUD
-->
<jsp:root xmlns:jsp="http://java.sun.com/JSP/Page"
          xmlns:f="http://java.sun.com/jsf/core"
          xmlns:af="http://xmlns.oracle.com/adf/faces/rich"
          version="2.1">

  <jsp:directive.page contentType="text/html;charset=UTF-8"/>

  <f:view>
    <af:document title="BurgerQuick - Employee Directory">

      <af:form>
        <af:panelHeader text="Employee Directory">

        <!-- Navigation Bar -->
        <af:panelGroupLayout layout="horizontal"
                             inlineStyle="background:#1a73e8;padding:8px 12px;margin-bottom:8px;border-radius:4px;">
          <af:commandButton text="Employees"
                            action="/pages/employeeDirectory.jspx"
                            id="navEmp" disabled="true"/>
          <af:spacer width="8"/>
          <af:commandButton text="Franchisees"
                            action="/pages/franchiseeDirectory.jspx"
                            id="navFran"/>
          <af:spacer width="8"/>
          <af:commandButton text="Inventory"
                            action="/pages/inventoryDirectory.jspx"
                            id="navInv"/>
          <af:spacer width="8"/>
          <af:commandButton text="Stores"
                            action="/pages/storeDirectory.jspx"
                            id="navStore"/>
        </af:panelGroupLayout>

        <!-- Toolbar -->
        <f:facet name="toolbar">
          <af:toolbar>
            <af:inputText label="Store #" simple="true"
                          value="#{employeeBean.searchStoreNumber}"
                          id="storeNumInput" columns="5"/>
            <af:commandButton text="Search"
                              actionListener="#{employeeBean.searchEmployees}"
                              id="searchBtn"/>
            <af:commandButton text="Show All"
                              action="#{employeeBean.clearSearch}"
                              id="clearBtn"/>
            <af:spacer width="20"/>
            <af:commandButton text="+ Hire Employee"
                              action="#{employeeBean.prepareAdd}"
                              id="addBtn"/>
          </af:toolbar>
        </f:facet>

        <!-- Status message -->
        <af:panelGroupLayout id="msgWrapper" partialTriggers="addBtn editBtn deleteBtn searchBtn cancelBtn saveBtn clearBtn">
          <af:panelGroupLayout id="msgPanel"
                               rendered="#{employeeBean.message != null}"
                               inlineStyle="background:#fff3cd;padding:8px;margin-bottom:10px;">
            <af:outputText value="#{employeeBean.message}" id="statusMsg"/>
          </af:panelGroupLayout>
        </af:panelGroupLayout>

        <!-- Add/Edit Form -->
        <af:panelGroupLayout id="formWrapper" partialTriggers="addBtn editBtn cancelBtn saveBtn clearBtn">
          <af:panelFormLayout id="editForm"
                              rendered="#{employeeBean.showForm}"
                              inlineStyle="background:#f0f0f0;padding:12px;margin-bottom:12px;border:1px solid #999;border-radius:4px;">

          <af:outputText value="#{employeeBean.editing ? 'Edit Employee: '.concat(employeeBean.editEmployeeId) : 'New Employee'}"
                         id="formTitle"
                         inlineStyle="font-size:14px;font-weight:bold;"/>

          <af:inputText label="First Name" value="#{employeeBean.editFirstName}"
                        id="editFn" required="true" columns="25"/>
          <af:inputText label="Last Name" value="#{employeeBean.editLastName}"
                        id="editLn" required="true" columns="25"/>
          <af:inputText label="Position" value="#{employeeBean.editPosition}"
                        id="editPos" columns="25"/>
          <af:inputText label="Hourly Rate" value="#{employeeBean.editHourlyRate}"
                        id="editRate" columns="10">
            <f:convertNumber pattern="#0.00"/>
          </af:inputText>
          <af:inputText label="Store #" value="#{employeeBean.editStoreNumber}"
                        id="editStore" columns="5"/>

          <af:panelGroupLayout layout="horizontal">
            <af:commandButton text="Save" action="#{employeeBean.saveEmployee}"
                              id="saveBtn"/>
            <af:spacer width="8"/>
            <af:commandButton text="Cancel" action="#{employeeBean.cancelEdit}"
                              id="cancelBtn" immediate="true"/>
          </af:panelGroupLayout>
        </af:panelFormLayout>
        </af:panelGroupLayout>

        <!-- Employee Table -->
        <af:table value="#{employeeBean.employees}"
                  var="row"
                  emptyText="No employees found."
                  id="employeeTable"
                  summary="Employee Directory"
                  partialTriggers="addBtn editBtn deleteBtn searchBtn cancelBtn saveBtn clearBtn">

          <af:column headerText="" id="colSelect" width="40" align="center">
            <af:commandLink text="#{row.employeeId == employeeBean.selectedEmployeeId ? 'Sel ✓' : 'Sel'}"
                            action="#{employeeBean.selectEmployee}"
                            id="clSelect"
                            partialSubmit="true"
                            inlineStyle="#{row.employeeId == employeeBean.selectedEmployeeId ? 'font-weight:bold;color:#1a73e8;' : ''}">
              <af:setActionListener from="#{row.employeeId}"
                                    to="#{employeeBean.selectedEmployeeId}"/>
            </af:commandLink>
          </af:column>

          <af:column sortable="true" headerText="ID" id="colId" width="130">
            <af:outputText value="#{row.employeeId}" id="otId"/>
          </af:column>

          <af:column sortable="true" headerText="First Name" id="colFirstName">
            <af:outputText value="#{row.firstName}" id="otFn"/>
          </af:column>

          <af:column sortable="true" headerText="Last Name" id="colLastName">
            <af:outputText value="#{row.lastName}" id="otLn"/>
          </af:column>

          <af:column sortable="true" headerText="Position" id="colPosition">
            <af:outputText value="#{row.position}" id="otPos"/>
          </af:column>

          <af:column sortable="true" headerText="Hourly Rate" id="colRate">
            <af:outputText value="#{row.hourlyRate}" id="otRate">
              <f:convertNumber type="currency"/>
            </af:outputText>
          </af:column>

          <af:column sortable="true" headerText="Store" id="colStore" width="60">
            <af:outputText value="#{row.storeNumber}" id="otStore"/>
          </af:column>
        </af:table>

        <!-- Actions -->
        <af:panelGroupLayout layout="horizontal" inlineStyle="margin-top:10px;">
          <af:outputText value="Selected: #{employeeBean.selectedEmployeeName}"
                         id="selectedLabel"
                         rendered="#{employeeBean.selectedEmployeeName != null}"
                         inlineStyle="margin-right:12px;font-weight:bold;color:#333;"/>
          <af:commandButton text="Edit Selected"
                            action="#{employeeBean.prepareEdit}"
                            id="editBtn"/>
          <af:spacer width="10"/>
          <af:commandButton text="Deactivate Selected"
                            action="#{employeeBean.deleteEmployee}"
                            id="deleteBtn"/>
        </af:panelGroupLayout>

      </af:panelHeader>
      </af:form>
    </af:document>
  </f:view>
</jsp:root>
