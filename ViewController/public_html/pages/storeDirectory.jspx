<jsp:root xmlns:jsp="http://java.sun.com/JSP/Page"
          xmlns:f="http://java.sun.com/jsf/core"
          xmlns:af="http://xmlns.oracle.com/adf/faces/rich"
          version="2.1">

  <jsp:directive.page contentType="text/html;charset=UTF-8"/>

  <f:view>
    <af:document title="BurgerQuick - Store Directory">

      <af:form>
        <af:panelHeader text="Store Directory">

        <!-- Navigation Bar -->
        <af:panelGroupLayout layout="horizontal"
                             inlineStyle="background:#1a73e8;padding:8px 12px;margin-bottom:8px;border-radius:4px;">
          <af:commandButton text="Employees"
                            action="/pages/employeeDirectory.jspx"
                            id="navEmp"/>
          <af:spacer width="8"/>
          <af:commandButton text="Franchisees"
                            action="/pages/franchiseeDirectory.jspx"
                            id="navFran"/>
          <af:spacer width="8"/>
          <af:commandButton text="Inventory"
                            action="/pages/inventoryDirectory.jspx"
                            id="navInv"/>
          <af:spacer width="8"/>
          <af:commandButton text="Create Delivery"
                            action="/pages/createInventoryDelivery.jspx"
                            id="navCreateDel"/>
          <af:spacer width="8"/>
          <af:commandButton text="Fulfill Delivery"
                            action="/pages/fulfillInventoryDelivery.jspx"
                            id="navFulfillDel"/>
          <af:spacer width="8"/>
          <af:commandButton text="Stores"
                            action="/pages/storeDirectory.jspx"
                            id="navStore" disabled="true"/>
        </af:panelGroupLayout>

        <!-- Toolbar -->
        <f:facet name="toolbar">
          <af:toolbar>
            <af:inputText label="City" simple="true"
                          value="#{storeBean.searchCity}"
                          id="cityInput" columns="15"/>
            <af:commandButton text="Search"
                              actionListener="#{storeBean.searchStores}"
                              id="searchBtn"/>
            <af:commandButton text="Show All"
                              action="#{storeBean.clearSearch}"
                              id="clearBtn"/>
            <af:spacer width="20"/>
            <af:commandButton text="+ Add Store"
                              action="#{storeBean.prepareAdd}"
                              id="addBtn"/>
          </af:toolbar>
        </f:facet>

        <!-- Status message -->
        <af:panelGroupLayout id="msgWrapper" partialTriggers="addBtn editBtn closeBtn searchBtn cancelBtn saveBtn clearBtn">
          <af:panelGroupLayout id="msgPanel"
                               rendered="#{storeBean.message != null}"
                               inlineStyle="background:#fff3cd;padding:8px;margin-bottom:10px;">
            <af:outputText value="#{storeBean.message}" id="statusMsg"/>
          </af:panelGroupLayout>
        </af:panelGroupLayout>

        <!-- Add/Edit Form -->
        <af:panelGroupLayout id="formWrapper" partialTriggers="addBtn editBtn cancelBtn saveBtn clearBtn">
          <af:panelFormLayout id="editForm"
                              rendered="#{storeBean.showForm}"
                              inlineStyle="background:#f0f0f0;padding:12px;margin-bottom:12px;border:1px solid #999;border-radius:4px;">

          <af:outputText value="#{storeBean.editing ? 'Edit Store #'.concat(storeBean.editStoreNumber) : 'New Store'}"
                         id="formTitle"
                         inlineStyle="font-size:14px;font-weight:bold;"/>

          <af:spacer width="1" height="1"/>

          <af:inputText label="Store #" value="#{storeBean.editStoreNumber}"
                        id="editStoreNum" required="true" columns="8"/>
          <af:inputText label="Store Name" value="#{storeBean.editStoreName}"
                        id="editStoreNm" required="true" columns="30"/>
          <af:inputText label="Address" value="#{storeBean.editAddress}"
                        id="editAddr" columns="35"/>
          <af:inputText label="City" value="#{storeBean.editCity}"
                        id="editCity" columns="20"/>
          <af:inputText label="State" value="#{storeBean.editState}"
                        id="editState" columns="3"/>
          <af:inputText label="Zip" value="#{storeBean.editZip}"
                        id="editZip" columns="10"/>
          <af:inputText label="Phone" value="#{storeBean.editPhone}"
                        id="editPhone" columns="15"/>
          <af:inputText label="Manager ID" value="#{storeBean.editManagerId}"
                        id="editMgr" columns="12"/>
          <af:inputText label="Seating Capacity" value="#{storeBean.editSeatingCapacity}"
                        id="editSeat" columns="6"/>
          <af:selectOneChoice label="Drive-Thru" value="#{storeBean.editDriveThruYn}"
                              id="editDt" unselectedLabel="">
            <af:selectItem label="Yes" value="Y"/>
            <af:selectItem label="No" value="N"/>
          </af:selectOneChoice>

          <af:panelGroupLayout layout="horizontal">
            <af:commandButton text="Save" action="#{storeBean.saveStore}"
                              id="saveBtn"/>
            <af:spacer width="8"/>
            <af:commandButton text="Cancel" action="#{storeBean.cancelEdit}"
                              id="cancelBtn" immediate="true"/>
          </af:panelGroupLayout>
        </af:panelFormLayout>
        </af:panelGroupLayout>

        <!-- Store Table -->
        <af:table value="#{storeBean.stores}"
                  var="row"
                  emptyText="No stores found."
                  id="storeTable"
                  summary="Store Directory"
                  partialTriggers="addBtn editBtn closeBtn searchBtn cancelBtn saveBtn clearBtn">

          <af:column headerText="" id="colSelect" width="40" align="center">
            <af:commandLink text="#{row.storeId == storeBean.selectedStoreId ? 'Sel ✓' : 'Sel'}"
                            action="#{storeBean.selectStore}"
                            id="clSelect"
                            partialSubmit="true"
                            inlineStyle="#{row.storeId == storeBean.selectedStoreId ? 'font-weight:bold;color:#1a73e8;' : ''}">
              <af:setActionListener from="#{row.storeId}"
                                    to="#{storeBean.selectedStoreId}"/>
            </af:commandLink>
          </af:column>

          <af:column sortable="true" headerText="ID" id="colId" width="60">
            <af:outputText value="#{row.storeId}" id="otId"/>
          </af:column>

          <af:column sortable="true" headerText="Store #" id="colStoreNum" width="80">
            <af:outputText value="#{row.storeNumber}" id="otStoreNum"/>
          </af:column>

          <af:column sortable="true" headerText="Name" id="colName">
            <af:outputText value="#{row.storeName}" id="otName"/>
          </af:column>

          <af:column sortable="true" headerText="City" id="colCity">
            <af:outputText value="#{row.city}" id="otCity"/>
          </af:column>

          <af:column sortable="true" headerText="State" id="colState" width="50">
            <af:outputText value="#{row.state}" id="otState"/>
          </af:column>

          <af:column sortable="true" headerText="Phone" id="colPhone">
            <af:outputText value="#{row.phone}" id="otPhone"/>
          </af:column>

          <af:column headerText="Drive-Thru" id="colDt" width="80" align="center">
            <af:outputText value="#{row.driveThruYn == 'Y' ? 'Yes' : 'No'}" id="otDt"/>
          </af:column>

          <af:column headerText="Open" id="colOpen" width="60" align="center">
            <af:outputText value="#{row.isOpen == 'Y' ? 'Yes' : 'No'}" id="otOpen"/>
          </af:column>
        </af:table>

        <!-- Actions -->
        <af:panelGroupLayout layout="horizontal" inlineStyle="margin-top:10px;">
          <af:outputText value="Selected: #{storeBean.selectedStoreName}"
                         id="selectedLabel"
                         rendered="#{storeBean.selectedStoreName != null}"
                         inlineStyle="margin-right:12px;font-weight:bold;color:#333;"/>
          <af:commandButton text="Edit Selected"
                            action="#{storeBean.prepareEdit}"
                            id="editBtn"/>
          <af:spacer width="10"/>
          <af:commandButton text="Close Selected"
                            action="#{storeBean.closeStore}"
                            id="closeBtn"/>
        </af:panelGroupLayout>

      </af:panelHeader>
      </af:form>
    </af:document>
  </f:view>
</jsp:root>
